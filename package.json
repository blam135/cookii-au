{
  "name": "cookii-au",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/secure-export.mjs",
    "start": "next start",
    "lint": "oxlint app",
    "format": "oxfmt",
    "test": "playwright test --project=regression",
    "test:ui": "playwright test --project=regression --ui",
    "dev:backend": "pnpm --filter cookii-reviews-worker dev",
    "test:all": "pnpm test && pnpm --filter cookii-reviews-worker test",
    "check:unused": "knip"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.9",
    "@next/env": "16.4.6",
    "lucide-react": "1.77.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "swr": "2.5.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "knip": "6.48.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "7.0.2"
  },
  "type": "module",
  "packageManager": "pnpm@10.34.5"
}
