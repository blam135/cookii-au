{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-21",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://REPLACE-WITH-YOUR-SITE.example",
    "TURNSTILE_HOSTNAME": "REPLACE-WITH-YOUR-SITE.example",
    "NOTION_DATA_SOURCE_ID": "REPLACE-WITH-DATA-SOURCE-ID",
    "SUBMISSIONS_ENABLED": "false",
  },
  "ratelimits": [
    {
      "name": "REVIEW_READ_LIMITER",
      "namespace_id": "71001",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      "name": "REVIEW_WRITE_LIMITER",
      "namespace_id": "71002",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "REVIEWS", "class_name": "ReviewsStore" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ReviewsStore"] }],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
}
